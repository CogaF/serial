<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings shared by every project of serial.sln - the one place to change what is built.

  Output layout (PlatformShortName is x64 or x86):
    Builds\<x64|x86>\<Debug|Release>\lib\serial.lib               static library (debug info embedded, /Z7)
    Builds\<x64|x86>\<Debug|Release>\dll\serial.dll / .lib / .pdb  DLL + its import library + symbols
    Builds\<x64|x86>\<Debug|Release>\test\                         smoke tests (run after each build)
    Builds\include\serial\serial.h, v8stdint.h                     headers for the users of the library
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <SerialRootDir>$(MSBuildThisFileDirectory)..\</SerialRootDir>
    <BuildRootDir Condition="'$(SerialStaticRuntime)'!='true'">$(MSBuildThisFileDirectory)..\Builds\</BuildRootDir>
    <!-- A static-C-runtime build goes to its own folder, so it never overwrites the normal one. -->
    <BuildRootDir Condition="'$(SerialStaticRuntime)'=='true'">$(MSBuildThisFileDirectory)..\Builds_StaticCRT\</BuildRootDir>
  </PropertyGroup>

  <PropertyGroup>
    <IntDir>$(MSBuildThisFileDirectory)obj\$(ProjectName)\$(PlatformShortName)\$(Configuration)\</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>false</SDLCheck>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalIncludeDirectories>$(SerialRootDir)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;_WINDOWS;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--
    C runtime: the DLL one (/MD, /MDd), as Visual Studio and wxWidgets use by default - a program must
    use the same kind as the libraries it links (with the DLL, std::string crosses the boundary).
    For a fully static program: build_all.bat static-crt (/MT, /MTd, output in Builds_StaticCRT\).
  -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary Condition="'$(SerialStaticRuntime)'!='true'">MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(SerialStaticRuntime)'=='true'">MultiThreadedDebug</RuntimeLibrary>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary Condition="'$(SerialStaticRuntime)'!='true'">MultiThreadedDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(SerialStaticRuntime)'=='true'">MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
</Project>
